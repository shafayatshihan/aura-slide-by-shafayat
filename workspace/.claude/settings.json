{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(.aura/venv/Scripts/python.exe .aura/engine/tools/:*)",
      "Bash(./.aura/venv/Scripts/python.exe .aura/engine/tools/:*)",
      "Bash(.aura/venv/Scripts/python.exe -c:*)",
      "Bash(node .aura/engine/tools/:*)",
      "Bash(node .aura/engine/rules/:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "PowerShell(.aura/venv/Scripts/python.exe .aura/engine/tools/:*)",
      "PowerShell(.aura\\venv\\Scripts\\python.exe .aura\\engine\\tools\\:*)",
      "PowerShell(./.aura/venv/Scripts/python.exe .aura/engine/tools/:*)",
      "PowerShell(.\\.aura\\venv\\Scripts\\python.exe .aura\\engine\\tools\\:*)",
      "PowerShell(& .aura/venv/Scripts/python.exe .aura/engine/tools/:*)",
      "PowerShell(& .\\.aura\\venv\\Scripts\\python.exe .aura\\engine\\tools\\:*)",
      "PowerShell(.aura/venv/Scripts/python.exe -c:*)",
      "PowerShell(node .aura/engine/tools/:*)",
      "PowerShell(node .aura\\engine\\tools\\:*)",
      "PowerShell(node .aura/engine/rules/:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Test-Path:*)",
      "PowerShell(New-Item:*)",
      "PowerShell(Copy-Item:*)",
      "PowerShell(Move-Item:*)"
    ],
    "deny": [
      "Edit(.aura/engine/**)",
      "Write(.aura/engine/**)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Read(**/.env)",
      "Bash(rm:*)",
      "Bash(git:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(git:*)",
      "PowerShell(Invoke-WebRequest:*)",
      "PowerShell(Invoke-Expression:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .aura/engine/rules/check_rules.js --hook",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .aura/engine/rules/check_rules.js --stop",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
