{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(python:*)",
      "Bash(py:*)",
      "Bash(.aura/venv/Scripts/python.exe:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)"
    ],
    "deny": [
      "Edit(.aura/engine/rules/**)",
      "Write(.aura/engine/rules/**)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Read(**/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node .aura/engine/rules/check_rules.js --hook", "timeout": 120 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node .aura/engine/rules/check_rules.js --stop", "timeout": 180 }
        ]
      }
    ]
  }
}
